PROVIDER_NAME=AI Epic Studio
PROVIDER_URL=https://www.aiepicstudio.com
PROVIDER_BASE_URL=http://localhost:6502

PRICING_SOURCES=vps,vds,custom

PRICING_VPS_LABEL=Example VPS
PRICING_VPS_URL=https://example.com/vps?currency={currency}
PRICING_VPS_SELECTOR=#example-vps-grid
PRICING_VPS_PRICE_PERCENT=0

PRICING_VDS_LABEL=Example VDS
PRICING_VDS_URL=https://example.com/vds?currency={currency}
PRICING_VDS_SELECTOR=#example-vds-grid
PRICING_VDS_PRICE_PERCENT=35

PRICING_CUSTOM_LABEL=Premium Dedicated
PRICING_CUSTOM_URL=https://example.com/dedicated?currency={currency}
PRICING_CUSTOM_SELECTOR=#premium-grid
PRICING_CUSTOM_PRICE_PERCENT=12.5
